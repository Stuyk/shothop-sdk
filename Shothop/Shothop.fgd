@PointClass size(-8.0 -8.0 -8.0, 8.0 8.0 8.0) color(204 204 204) = trigger_enemy_arena_spawner : "Arena wave spawner manager. Spawns random or static waves of enemies and triggers targets when cleared.

Properties:
- enabled: Whether the arena spawner starts active immediately.
- rng_enemy_pool: Comma-separated list of enemy type enum integers. If blank, any type can spawn.
- rng_enemies_per_wave: Number of enemies to spawn per wave.
- rng_wave_count: Total number of waves (ignored if static spawn type is used).
- spawn_points: Target name of info_markers to randomly use for spawning. If empty, spawns at parent node.
- spawn_type: Spawn mode: 'random' or 'static'.
- static_spawn: Static wave definitions, wave-separated by semicolon, enemy-separated by comma, e.g., '1,1,1;4,4'.
- uid_to_invoke: The uid of the entity to invoke.

ENEMY_MELEE - 1
ENEMY_DYNAMITE - 2
ENEMY_ARCANE - 3
ENEMY_SHOOTER - 4
ENEMY_SHIELD - 5
ENEMY_ACHILLES - 6
ENEMY_SPIDER - 7
ENEMY_FLYING_DRONE - 8
ENEMY_LOOTBOT - 9
ENEMY_FLAMETHROWER - 10
ENEMY_GASBOT - 11
ENEMY_SPINNER - 12
ENEMY_TURRET_STANDING - 13
ENEMY_MINEBOT - 14
ENEMY_MINIGUN - 15
ENEMY_KNIFE - 16
ENEMY_ROCKETBOT - 17
ENEMY_HAMMER - 18" 
[
	enabled(choices) : "Whether the arena spawner starts active immediately." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	rng_enemies_per_wave(integer) : "Number of enemies to spawn per wave." : 5
	rng_enemy_pool(string) : "Comma-separated list of enemy type enum integers. If blank, any type can spawn." : ""
	rng_wave_count(integer) : "Total number of waves (ignored if static spawn type is used)." : 3
	spawn_points(string) : "Target name of info_markers to randomly use for spawning. If empty, spawns at parent node." : ""
	spawn_type(string) : "Spawn mode: 'random' or 'static'." : "random"
	static_spawn(string) : "Static wave definitions, wave-separated by semicolon, enemy-separated by comma, e.g., '1,1,1;4,4'." : ""
	uid_to_invoke(string) : "The uid of the entity to invoke." : "The uid of the entity to invoke."
]

