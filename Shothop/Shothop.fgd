@SolidClass color(204 204 204) = trigger_move_brush : "Creates a moveable piece of geometry that can be moved by a trigger area.

Properties:
- direction: The Vector3 direction which the brush moves.
- move_distance: Distance the brush travels when activated.
- move_speed: Speed at which the brush moves.
- uid: Unique id for this entity. Other entities reference it by this value.
- toggleable: If true, the brush toggles between states instead of a one-shot move.
- enable_sound: If true (default), plays door open audio when activated.
- sync_audio_duration: If true (default), moves at a speed matching the duration of the audio sound.
- audio_stop_offset: Time in seconds before the end of the audio when the stop hit occurs (default 1.2)." 
[
	audio_stop_offset(float) : "Time in seconds before the end of the audio clip when the stop impact occurs (default 1.2)." : "1.2"
	direction(string) : "The Vector3 direction which the brush moves." : "0.0 -1.0 0.0"
	enable_sound(choices) : "If true (default), plays door open audio when activated." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	move_distance(float) : "Distance the brush travels when activated." : "2.0"
	move_speed(float) : "Speed at which the brush moves (fallback if sound/sync is disabled)." : "1.0"
	sync_audio_duration(choices) : "If true (default), moves at a speed matching the duration of the audio sound." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	toggleable(choices) : "If true, the brush toggles between states instead of a one-shot move." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	uid(string) : "Unique id for this entity. Other entities reference it by this value." : "Unique id for this entity. Other entities reference it by this value."
]

