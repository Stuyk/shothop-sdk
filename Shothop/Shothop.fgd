@PointClass size(-8.0 -8.0 -8.0, 8.0 8.0 8.0) color(204 204 204) = audio_ambient_sound : "Positional 3D ambient sound node that plays an .ogg audio loop at this point location. Automatically searches res://assets/audio/ and user://maps/ recursively by filename. Routes audio to the 'ambience' bus by default.

Properties:
- autoplay: Whether the ambient audio starts playing automatically on map load (default true).
- bus: Audio bus name to route the sound (default 'ambience').
- distance: Maximum audible distance for the 3D positional falloff (default 50.0). Ignored when 'global' is enabled.
- global: When enabled, disables distance falloff so the audio plays at full volume throughout the entire map.
- loop: Whether the sound continuously loops when finished (default true).
- pitch_scale: Pitch scale multiplier (default 1.0).
- sound_name: Name of the .ogg audio file (e.g. 'ambient_drone', 'ambient_cave', or 'ambient_river.ogg').
- volume_db: Volume offset in dB (default 0.0 dB)." 
[
	autoplay(choices) : "Whether the audio starts playing automatically on map load." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	bus(string) : "Audio bus name to route the sound (e.g. 'ambience')." : "ambience"
	distance(float) : "Maximum audible distance for 3D positional falloff. Ignored when 'global' is true." : "50.0"
	global(choices) : "Disables distance falloff so audio plays at full volume level-wide." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	loop(choices) : "Whether the audio continuously loops when finished." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	pitch_scale(float) : "Pitch scale multiplier." : "1.0"
	sound_name(string) : "Name of the .ogg audio file to play (searches res://assets/audio/ and user://maps/ automatically)." : "ambient_drone"
	volume_db(float) : "Volume adjustment in dB." : "0.0"
]

