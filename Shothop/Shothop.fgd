@SolidClass color(204 204 204) = func_display_poster : "Custom digital poster display screen brush. Stretches a poster texture across the brush geometry with a CRT screen overlay. Deterministically selects from JPL posters based on world position by default, or supports manual poster index and random mode.

Properties:
- poster_index: Specific poster index (0-14). Set to -1 for automatic selection.
- deterministic: If true and poster_index is -1, deterministically picks a poster from the brush position. If false, picks randomly.
- destroyable: Whether this screen can be damaged/destroyed by weapons.
- flip_x: If true, horizontally flips the projected poster.
- flip_y: If true, vertically flips the projected poster.
- glow_intensity: Emissive brightness multiplier for the screen texture (default 2.0).
- enable_light: Whether to spawn an OmniLight3D illuminating the area in front of the screen.
- light_energy: Light energy of the OmniLight3D (default 2.0).
- light_color: Color of the OmniLight3D light source.
- poster_dir: Resource path to directory containing poster images." 
[
	destroyable(choices) : "Whether this screen can be damaged/destroyed by weapons." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	deterministic(choices) : "If true and poster_index is -1, deterministically picks a poster from brush position." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	enable_light(choices) : "Whether to spawn an OmniLight3D illuminating the area in front of the screen." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	flip_x(choices) : "If true, horizontally flips the projected poster." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	flip_y(choices) : "If true, vertically flips the projected poster." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	glow_intensity(float) : "Emissive brightness multiplier for the screen texture (default 2.0)." : "2.0"
	light_color(color255) : "Color of the OmniLight3D light source." : "230 230 255"
	light_energy(float) : "Light energy of the OmniLight3D (default 2.0)." : "2.0"
	poster_dir(string) : "Resource path to directory containing poster images." : "res://assets/textures/posters/jpl"
	poster_index(integer) : "Specific poster index to show (0-14). Set to -1 for automatic selection." : -1
]

