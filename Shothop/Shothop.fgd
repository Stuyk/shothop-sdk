@SolidClass color(204 204 204) = trigger_area : "Invokes triggers with different behavior.

Properties:
- emit_bus: Target event bus channel name to notify when this area is triggered.
- is_button: If true, the area behaves like a button requiring press/interaction rather than automatic entry.
- is_player_only: If true, only the player can activate this area (ignores NPCs and physics objects).
- keycard: Required keycard type identifier to allow activation (leave empty for no gating).
- ms_timeout: Cooldown in milliseconds between consecutive activations.
- trigger_once: If true, the area triggers only once and then disables itself.
- uid_to_invoke: The uid of the entity to invoke." 
[
	emit_bus(string) : "Target event bus channel name to notify when this area is triggered." : ""
	is_button(choices) : "If true, the area behaves like a button requiring press/interaction rather than automatic entry." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	is_player_only(choices) : "If true, only the player can activate this area (ignores NPCs and physics objects)." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	keycard(string) : "Required keycard type identifier to allow activation (leave empty for no gating)." : ""
	ms_timeout(float) : "Cooldown in milliseconds between consecutive activations." : "0.0"
	trigger_once(choices) : "If true, the area triggers only once and then disables itself." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	uid_to_invoke(string) : "The uid of the entity to invoke." : "The uid of the entity to invoke."
]

@PointClass size(-8.0 -8.0 -8.0, 8.0 8.0 8.0) color(204 204 204) = trigger_sound : "Adds a triggerable sound. Make sure to add a name to the trigger_name property. It needs a corresponding trigger to invoke it.

Properties:
- audio_path: Filename (no extension needed) of the .ogg to play when triggered. Searched in bundled game audio (res://assets/audio/sfx/) first, then user://maps, then finally tried as a literal path. If none match, plays nothing.
- audio_type: 0 - 3D, 1 - 2D
- ms_delay: Delay in milliseconds before the sound plays after trigger activation.
- uid: Unique id for this entity. Other entities reference it by this value." 
[
	audio_path(string) : "Filename (no extension needed) of the .ogg to play when triggered. Searched in bundled game audio (res://assets/audio/sfx/) first, then user://maps, then finally tried as a literal path. If none match, plays nothing." : ""
	audio_type(integer) : "0 - 3D, 1 - 2D" : 0
	ms_delay(float) : "Delay in milliseconds before the sound plays after trigger activation." : "0.0"
	uid(string) : "Unique id for this entity. Other entities reference it by this value." : "Unique id for this entity. Other entities reference it by this value."
]

