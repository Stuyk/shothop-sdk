@PointClass size(-8.0 -8.0 -8.0, 8.0 8.0 8.0) color(204 204 204) = audio_loop : "Positional 3D audio loop that plays continuously on map load. Uses distance-based attenuation and audio occlusion. Set 'path' to a res:// resource path pointing to an .ogg file. Ambient loops live under res://assets/audio/ambient/ (e.g. ambient_cave.ogg, ambient_river.ogg). SFX-style ambient sounds live under res://assets/audio/sfx/ambient/ (e.g. ambient_fan.ogg, sfx_fire_loop.ogg). Routes audio through the 'sfx' bus by default.

Properties:
- bus: Audio bus name to route the sound (e.g., 'sfx').
- distance: Maximum audible distance for the loop (units in map space). Ignored when 'global' is enabled.
- global: When enabled, disables distance falloff so the audio plays at full volume throughout the entire level. Overrides the 'distance' property.
- path: Godot resource path to an .ogg audio file (must start with res://). Ambient loops: res://assets/audio/ambient/ambient_cave.ogg. SFX-style: res://assets/audio/sfx/ambient/ambient_fan.ogg." 
[
	bus(string) : "Audio bus name to route the sound (e.g., 'sfx')." : "sfx"
	distance(float) : "Maximum audible distance for the loop (units in map space). Ignored when 'global' is enabled." : "50.0"
	global(choices) : "When enabled, disables distance falloff so the audio plays at full volume throughout the entire level. Overrides the 'distance' property." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	path(string) : "Godot resource path to an .ogg audio file (must start with res://). Ambient loops: res://assets/audio/ambient/ambient_cave.ogg. SFX-style: res://assets/audio/sfx/ambient/ambient_fan.ogg." : ""
]

