@SolidClass color(204 204 204) = platform_crusher : "Configurable crushing block. Extends toward a named target marker, becomes lethal at max extension, then retracts back to its start and repeats. Can optionally 'fake out' with partial jabs before a real crush. Plays built-in push/pull/impact crush SFX and a dust burst automatically, no audio_attached needed.

Properties:
- uid: Unique id for this entity. Other entities reference it by this value.
- uid_to_move_to: The uid of the marker/waypoint to move to.
- move_speed: Movement speed of the brush while extending/retracting.
- start_delay: Seconds to wait after map load before the first cycle begins.
- retracted_pause: Seconds the brush rests fully retracted before starting the next cycle.
- extended_pause: Seconds the brush stays at full extension (lethal window) before retracting.
- fake_crush_count: Number of partial 'fake out' jabs performed before the real crush each cycle.
- fake_crush_percent: How far (0-1 of the distance to target) each fake jab extends.
- fake_crush_pause: Seconds paused at the peak/bottom of each fake jab.
- fake_crush_speed_multiplier: Speed multiplier applied to fake jabs (e.g. faster, punchier than the real crush).
- lethal: If true, the kill zone at full extension damages the player (and anything with invoke_damage) on contact." 
[
	extended_pause(float) : "Seconds the brush stays at full extension (lethal window) before retracting." : "0.4"
	fake_crush_count(integer) : "Number of partial 'fake out' jabs performed before the real crush each cycle." : 0
	fake_crush_pause(float) : "Seconds paused at the peak/bottom of each fake jab." : "0.15"
	fake_crush_percent(float) : "How far (0-1 of the distance to target) each fake jab extends." : "0.3"
	fake_crush_speed_multiplier(float) : "Speed multiplier applied to fake jabs (e.g. faster, punchier than the real crush)." : "1.5"
	lethal(choices) : "If true, the kill zone at full extension damages the player (and anything with invoke_damage) on contact." : 1 = 
	[
		0 : "No"
		1 : "Yes"
	]
	move_speed(float) : "Movement speed of the brush while extending/retracting." : "6.0"
	uid(string) : "Unique id for this entity. Other entities reference it by this value." : "Unique id for this entity. Other entities reference it by this value."
	retracted_pause(float) : "Seconds the brush rests fully retracted before starting the next cycle." : "1.5"
	start_delay(float) : "Seconds to wait after map load before the first cycle begins." : "0.0"
	uid_to_move_to(string) : "The uid of the marker/waypoint to move to." : "The uid of the marker/waypoint to move to."
]

