@SolidClass color(204 204 204) = trigger_elevator : "Creates an elevator. The end point must be a info_market_target, and will automatically move to the market target if the player is on the platform. Additionally, moves back after the player leaves the platform.

Properties:
- is_hub_elevator: If true, elevator behaves as a hub transport between multiple markers.
- is_remote_triggered: If true, elevator only moves when triggered remotely via name/target.
- uid: Unique id for this entity. Other entities reference it by this value.
- pause_at_top: Time in milliseconds to pause at the top/stop destination before returning down.
- speed: Movement speed of the elevator platform.
- stop_at_end: If true, elevator disables itself permanently once it reaches its stop destination (no return trip, no further use).
- uid_to_move_to: The uid of the marker/waypoint to move to." 
[
	is_hub_elevator(choices) : "If true, elevator behaves as a hub transport between multiple markers." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	is_remote_triggered(choices) : "If true, elevator only moves when triggered remotely via name/target." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	uid(string) : "Unique id for this entity. Other entities reference it by this value." : "Unique id for this entity. Other entities reference it by this value."
	pause_at_top(integer) : "Time in milliseconds to pause at the top/stop destination before returning down." : 3000
	speed(float) : "Movement speed of the elevator platform." : "10.0"
	stop_at_end(choices) : "If true, elevator disables itself permanently once it reaches its stop destination (no return trip, no further use)." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	uid_to_move_to(string) : "The uid of the marker/waypoint to move to." : "The uid of the marker/waypoint to move to."
]

@SolidClass color(204 204 204) = info_water_transparent : "Creates a water hazard, instant-death needs to be toggled on to kill the player if they touch it.

Properties:
- color: Water color used for rendering and visual tinting.
- instant_kill: If true, the player dies instantly upon entering the water hazard.
- subdivisions: Grid resolution of the water surface mesh. Higher = smoother waves, more verts.
- teleport_name: Optional marker name to teleport the player to on death or hazard exit." 
[
	color(color255) : "Water color used for rendering and visual tinting." : "42 60 62"
	instant_kill(choices) : "If true, the player dies instantly upon entering the water hazard." : 0 = 
	[
		0 : "No"
		1 : "Yes"
	]
	subdivisions(integer) : "Grid resolution of the water surface mesh. Higher = smoother waves, more verts." : 16
	teleport_name(string) : "Optional marker name to teleport the player to on death or hazard exit." : ""
]

